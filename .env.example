# PostgreSQL-Verbindung
DATABASE_URL="postgresql://incubworkflow:incubworkflow@localhost:5432/incubworkflow"

# Geheimnis zum Signieren der Session-Cookies (min. 32 Zeichen, z. B. via `openssl rand -hex 32`)
AUTH_SECRET="bitte-aendern-mindestens-32-zeichen-lang"

# Zugangsdaten des initialen Admin-Kontos (wird beim Seed angelegt)
ADMIN_EMAIL="admin@incub.live"
ADMIN_PASSWORD="incub2026!"
ADMIN_NAME="Maik Janke"

# Wurzelverzeichnis der Beleg-Ablage (Ordnerstruktur laut Spec, Abschnitt 7)
STORAGE_PATH="./incubWorkflow-Ablage"

# Claude API für das automatische Auslesen der Belege (Sprint 2).
# Ohne Schlüssel funktioniert alles, die Felder werden dann manuell erfasst.
ANTHROPIC_API_KEY=""
# Optional: Modell für die Extraktion (Standard: claude-opus-4-8)
ANTHROPIC_MODEL="claude-opus-4-8"
