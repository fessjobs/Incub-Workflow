# Supabase – Projekt-URL und öffentlicher anon key.
# Beides findest du unter Supabase Dashboard → Project Settings → API.
# Der anon key ist öffentlich und darf im Browser landen; der service_role key
# gehört NIEMALS in diese Datei oder ins Repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
