// incubWorkflow – Datenmodell (Spec Abschnitt 10)
// Alle Tabellen von Tag 1 angelegt, auch die erst in späteren Sprints befüllten.
// Jede fachliche Tabelle trägt organizationId für die Mandantentrennung.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Mandanten-Ebene ────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Branding pro Mandant (SaaS-Vorbereitung); Default = INCUB-LIVE-Theme
  brandName    String  @default("incub:workflow")
  tagline      String  @default("Belege. Erledigt.")
  primaryColor String  @default("#0B1220")
  logoUrl      String?
  // Selbst-Registrierung erlaubt? (Mitglieder können sich selbst anlegen)
  allowSelfRegistration Boolean @default(true)
  // Passwort für den öffentlichen Mitarbeiter-Link (/mitarbeiter)
  employeeLinkPassword  String  @default("123")
  // Wurzelpfad der Datei-Ablage (Spec Abschnitt 7), pro Mandant konfigurierbar
  storagePath  String  @default("./incubWorkflow-Ablage")
  // Onboarding-Assistent abgeschlossen?
  onboarded    Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  companies        Company[]
  categories       Category[]
  receipts         Receipt[]
  vehicles         Vehicle[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  matchRules       MatchRule[]
  auditLogs        AuditLog[]
  corporateCards   CorporateCard[]
  persons          Person[]
  setcards         Setcard[]

  @@map("organizations")
}

// ─── Nutzer & Rollen ────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  // Buchhaltung: sieht alle Belege und Auswertungen (für DATEV-Export),
  // aber keine Verwaltung/Einstellungen.
  BUCHHALTUNG
  MEMBER
  // Vereinfachtes Kiosk-Konto: nur Belege erfassen (eine Firma), kein Zugriff
  // auf Listen/Auswertungen/Einstellungen. Name wird pro Upload eingegeben.
  EINREICHER
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  name           String
  role           UserRole @default(MEMBER)
  active         Boolean  @default(true)
  // Selbst registrierte Konten müssen vom Admin freigeschaltet werden
  approved       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id])
  // Optional einschränkbar, für welche Firmen der Nutzer Belege einreichen darf.
  // Keine Einträge = alle Firmen erlaubt.
  companyAccess   UserCompanyAccess[]
  receipts        Receipt[]
  receiptVersions ReceiptVersion[]
  auditLogs       AuditLog[]
  bankAccounts    BankAccount[]
  corporateCards  CorporateCard[]

  @@index([organizationId])
  @@map("users")
}

model UserCompanyAccess {
  userId    String
  companyId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("user_company_access")
}

// ─── Firmen: Marke ≠ Rechtsträger (Spec Abschnitt 4) ───────────────────────

model Company {
  id             String  @id @default(cuid())
  organizationId String
  // Marke (UI-Ebene)
  brandName String
  logoUrl   String?
  color     String?
  location  String?
  // Rechtsträger (erscheint auf dem Beiblatt)
  legalName String?
  address   String?
  // Kürzel für den Belegnummernkreis, z. B. "FJ" → FJ-2026-0001
  shortCode String
  // "Privat" ist eine Pseudo-Firma für private Ausgaben
  isPrivate Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization           @relation(fields: [organizationId], references: [id])
  userAccess       UserCompanyAccess[]
  receipts         Receipt[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  numberCounters   ReceiptNumberCounter[]
  setcards         Setcard[]

  @@unique([organizationId, shortCode])
  @@index([organizationId])
  @@map("companies")
}

// ─── Kategorien (pflegbar, pro Organization) ────────────────────────────────

model Category {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  // Steuert Sonderfall-Logik (z. B. Bewirtungsbeleg-Block auf dem Beiblatt)
  isHospitality Boolean @default(false)
  // Blendet Fahrzeug + Kilometerstand ein (Tank-/Fahrtkostenbelege)
  isFuel        Boolean @default(false)
  active        Boolean @default(true)
  sortOrder     Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  receipts     Receipt[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

// ─── Belege (Kern, wird ab Sprint 2 befüllt) ───────────────────────────────

enum ReceiptKind {
  AUSLAGE // privat verauslagt, Erstattung erwartet
  FIRMENZAHLUNG
  PRIVAT
}

enum PaymentMethod {
  BAR
  PRIVATE_KARTE
  FIRMENKARTE
  UNBEKANNT
}

enum ReceiptStatus {
  ENTWURF
  ABGELEGT
}

enum ReimbursementStatus {
  OFFEN
  EINGEREICHT
  ERSTATTET
}

// Ist die Rechnung/der Beleg selbst schon bezahlt oder noch zu zahlen?
// (wichtig für den Schnell-Upload der Gesellschafter)
enum PaidStatus {
  BEZAHLT
  ZU_ZAHLEN
}

// Freigabe-Workflow für Belege vom Mitarbeiter-Link: erst nach Admin-Freigabe
// arbeitet die Buchhaltung damit (Listen + DATEV/Exporte). Bei Ablehnung gibt
// es einen Kommentar für den Mitarbeiter.
enum EmployeeReviewStatus {
  AUSSTEHEND
  FREIGEGEBEN
  ABGELEHNT
}

// Firmenkarten (z. B. eine Amex pro Gesellschafter). Belege mit Zahlungsart
// "Firmenkarte" werden der konkreten Karte zugeordnet und für die Buchhaltung
// pro Karte abgelegt.
model CorporateCard {
  id             String  @id @default(cuid())
  organizationId String
  // z. B. "Amex Maik"
  label          String
  // Karteninhaber (Gesellschafter), optional
  holderUserId   String?
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  holder       User?        @relation(fields: [holderUserId], references: [id])
  receipts     Receipt[]

  @@unique([organizationId, label])
  @@index([organizationId])
  @@map("corporate_cards")
}

model Receipt {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  // Firma wird beim schnellen Zuordnen gewählt; im Entwurf noch leer
  companyId      String?
  categoryId     String?

  // Belegnummer: {Firmenkürzel}-{Jahr}-{laufende Nr.}, Nummernkreis pro Firma+Jahr.
  // Erst beim Ablegen vergeben – im Entwurf noch leer.
  receiptNumber String? @unique
  numberYear    Int?
  numberSeq     Int?

  // Ausgelesene / bestätigte Belegdaten
  receiptDate   DateTime
  vendor        String  @default("")
  grossAmount   Decimal @default(0) @db.Decimal(12, 2)
  netAmount     Decimal? @db.Decimal(12, 2)
  // Gemischte USt-Sätze auf einem Bon: [{rate: 19, vat: 1.90, net: 10.00}, ...]
  vatLines      Json?
  paymentMethod PaymentMethod @default(UNBEKANNT)
  // Konkrete Firmenkarte (z. B. "Amex Maik"), wenn paymentMethod FIRMENKARTE
  corporateCardId String?
  // Rechnung schon bezahlt oder noch zu zahlen?
  paidStatus    PaidStatus    @default(BEZAHLT)
  kind          ReceiptKind   @default(AUSLAGE)
  // Geschäftlicher Anlass/Zweck (prüfungsrelevant)
  purpose       String?
  // Kreuz "geprüft/freigegeben" hinter dem Namen des Einreichers
  approved      Boolean @default(false)
  // Freitext-Name des Einreichers (Kiosk/geteiltes Konto) – überschreibt auf
  // dem Beiblatt den Kontonamen, wenn gesetzt
  submittedByName String?
  // Über den öffentlichen Mitarbeiter-Link eingereicht → landet im Ordner
  // "Auslagen Mitarbeiter" im Adminbereich
  viaEmployeeLink Boolean @default(false)
  // Freigabe-Status (nur für Mitarbeiter-Link-Belege gesetzt)
  employeeReview        EmployeeReviewStatus?
  // Kommentar an den Mitarbeiter bei Ablehnung (im Belegtool sichtbar)
  employeeReviewComment String?

  // Sonderfall Bewirtung
  hospitalityGuests   String?
  hospitalityOccasion String?
  hospitalityLocation String?

  // Sonderfall Tank-/Fahrtkostenbeleg
  vehicleId  String?
  odometerKm Int?

  // Freitext/Bemerkungen – erscheint auf dem Beiblatt
  notes String?

  // Sonderfall Eigenbeleg
  isSelfReceipt     Boolean @default(false)
  selfReceiptReason String?

  status              ReceiptStatus       @default(ENTWURF)
  reimbursementStatus ReimbursementStatus @default(OFFEN)
  reimbursedAt        DateTime?

  // "In DATEV hochgeladen" – Haken der Buchhaltung/des Admins in der Belegliste
  datevUploadedAt DateTime?

  // Dateiablage (Spec Abschnitt 7)
  originalPath String?
  pdfPath      String?

  currentVersion Int @default(1)

  // Demo-Beleg (für Produktvorführungen; per Schalter entfernbar)
  isDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  company       Company?         @relation(fields: [companyId], references: [id])
  category      Category?        @relation(fields: [categoryId], references: [id])
  vehicle       Vehicle?         @relation(fields: [vehicleId], references: [id])
  corporateCard CorporateCard?   @relation(fields: [corporateCardId], references: [id])
  versions      ReceiptVersion[]
  transactions  BankTransaction[]
  paymentLinks  TransactionReceiptLink[]
  files         ReceiptFile[]

  @@index([organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, companyId])
  @@index([organizationId, receiptDate])
  // Dubletten-Check: Betrag + Datum + Aussteller
  @@index([organizationId, grossAmount, receiptDate, vendor])
  @@map("receipts")
}

// Versionshistorie: bei jeder Änderung wird der vorherige Stand als Snapshot
// abgelegt, alte PDF-Versionen bleiben referenziert (Audit-Anforderung).
model ReceiptVersion {
  id          String   @id @default(cuid())
  receiptId   String
  versionNo   Int
  data        Json
  pdfPath     String?
  createdById String
  createdAt   DateTime @default(now())

  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@unique([receiptId, versionNo])
  @@map("receipt_versions")
}

// Datei-Ablage als Bytes in der DB (funktioniert auch auf Hostern mit
// flüchtigem Dateisystem wie Railway; ist die verlässliche Quelle). Die
// Ordnerstruktur/Dateinamen aus Spec Abschnitt 7 stehen in receipts.pdfPath /
// originalPath und werden beim Export materialisiert.
enum ReceiptFileKind {
  ORIGINAL // unverändertes Original (Foto/PDF)
  PDF      // generierte PDF (Beiblatt + Beleg)
}

model ReceiptFile {
  id        String          @id @default(cuid())
  receiptId String
  kind      ReceiptFileKind
  filename  String
  mimeType  String
  bytes     Bytes
  size      Int
  createdAt DateTime        @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId, kind])
  @@map("receipt_files")
}

// Fahrzeuge (für Tank-/Fahrtkostenbelege) – werden beim Erfassen automatisch
// angelegt, wenn ein neuer Name eingetippt wird
model Vehicle {
  id             String  @id @default(cuid())
  organizationId String
  name           String // z. B. "VW Passat · MZ-AB 123"
  active         Boolean @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  receipts     Receipt[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("vehicles")
}

// Nummernkreis pro Firma und Jahr
model ReceiptNumberCounter {
  companyId  String
  year       Int
  lastNumber Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, year])
  @@map("receipt_number_counters")
}

// ─── Bank-Abgleich (wird in Sprint 4 befüllt) ──────────────────────────────

model BankAccount {
  id             String  @id @default(cuid())
  organizationId String
  // Optionale Zuordnung Konto → Firma (Firmenkonten, vom Admin gepflegt)
  companyId String?
  // Persönliches Konto: gehört diesem Nutzer – nur er (und Admin) sieht es.
  // Kontoauszüge werden damit dem Benutzer zugeordnet, nicht einer Firma.
  userId    String?
  name      String
  iban      String?
  isPrivate Boolean @default(false)
  active    Boolean @default(true)
  isDemo    Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  company      Company?          @relation(fields: [companyId], references: [id])
  owner        User?             @relation(fields: [userId], references: [id])
  transactions BankTransaction[]

  @@index([organizationId])
  @@index([userId])
  @@map("bank_accounts")
}

model BankTransaction {
  id             String   @id @default(cuid())
  organizationId String
  bankAccountId  String
  bookingDate    DateTime
  amount         Decimal  @db.Decimal(12, 2)
  counterparty   String?
  purpose        String?
  // Rohdaten der Import-Zeile (CSV/PDF-Extraktion)
  raw            Json?

  matchedReceiptId String?
  ignored          Boolean @default(false)
  // Freigabe: Buchung wurde geprüft (Privat/Firma zugeordnet, ggf. Beleg
  // verknüpft) und abgehakt
  reviewed         Boolean @default(false)
  // Merkregel, durch die dieser Posten automatisch behandelt wurde
  matchRuleId      String?
  // "Diese Ausgabe war für Firma X" – pro Kontobewegung wählbar (z. B. private
  // Karte, verauslagt für unterschiedliche Firmen)
  companyId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  bankAccount    BankAccount  @relation(fields: [bankAccountId], references: [id])
  matchedReceipt Receipt?     @relation(fields: [matchedReceiptId], references: [id])
  matchRule      MatchRule?   @relation(fields: [matchRuleId], references: [id])
  company        Company?     @relation(fields: [companyId], references: [id])
  receiptLinks   TransactionReceiptLink[]

  @@index([organizationId])
  @@index([bankAccountId, bookingDate])
  @@map("bank_transactions")
}

// Sammel-Abbuchung ↔ mehrere Einzelbelege (z. B. Amazon bündelt Rechnungen):
// eine Kontobewegung kann über diese Tabelle mit mehreren Belegen verknüpft
// sein. matchedReceiptId zeigt dabei zusätzlich auf den ersten Beleg, damit
// die Buchung überall als "zugeordnet" gilt.
model TransactionReceiptLink {
  id            String   @id @default(cuid())
  transactionId String
  receiptId     String
  createdAt     DateTime @default(now())

  transaction BankTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  receipt     Receipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([transactionId, receiptId])
  @@index([receiptId])
  @@map("transaction_receipt_links")
}

// Merkregeln für wiederkehrende Buchungen (z. B. Miete, Gehälter → ignorieren)
model MatchRule {
  id             String  @id @default(cuid())
  organizationId String
  // Muster auf Gegenpartei/Verwendungszweck
  pattern String
  action  String  @default("IGNORE")
  note    String?
  active  Boolean @default(true)
  createdAt DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  transactions BankTransaction[]

  @@index([organizationId])
  @@map("match_rules")
}

// ─── Setcard-Maker (Personal-Setcards pro Firma) ────────────────────────────

// Personal-Stamm: einmal erfasste Personen werden wiederverwendet und beim
// nächsten Mal vorbefüllt (Mitlernen). Ausweis/CV-Uploads werden NUR zum
// Auslesen verwendet und nicht gespeichert – nur diese Strukturdaten + Foto.
model Person {
  id             String  @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  // Basisdaten (alle optional – was eben bekannt ist)
  birthYear  Int?
  age        Int?
  city       String?
  region     String?
  phone      String?
  email      String?
  languages  String? // "Deutsch (Muttersprache) · Englisch (B1)"
  mobility   String? // "Führerschein Kl. B · eigener Pkw"
  // Strukturierte Daten als JSON: experiences [{from,to,title,company,details}],
  // qualifications [string], skills [string]
  experiences    Json?
  qualifications Json?
  skills         Json?
  profileText    String?
  notes          String?
  // Foto (klein, fürs Setcard)
  photoBytes Bytes?
  photoMime  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  setcards     Setcard[]

  @@index([organizationId, lastName])
  @@map("persons")
}

// Erstellte Setcards: finaler Datenstand (fürs Mitlernen) + fertige PDF
model Setcard {
  id             String @id @default(cuid())
  organizationId String
  personId       String
  companyId      String
  einsatzbereich String
  profileNo      String // z. B. "EP-2601"
  // Vollständiger, ggf. manuell korrigierter Karteninhalt (Template-Slots)
  data      Json
  pdfBytes  Bytes?
  createdById String?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  company      Company      @relation(fields: [companyId], references: [id])

  @@index([organizationId, personId])
  @@map("setcards")
}

// ─── Audit-Log ──────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String // z. B. company.create, user.update, receipt.update
  entityType     String
  entityId       String?
  data           Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_log")
}
